@model Cliente
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3"><div class="col-md-6"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control"/><span asp-validation-for="Nome" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Cpf" class="form-label"></label><input asp-for="Cpf" class="form-control" maxlength="11"/><span asp-validation-for="Cpf" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="PlanoId" class="form-label">Plano</label><select asp-for="PlanoId" asp-items="ViewBag.Planos" class="form-select"><option value="0">Selecione</option></select><span asp-validation-for="PlanoId" class="text-danger"></span></div>
<div class="col-12"><div class="form-check"><input asp-for="Ativo" class="form-check-input"/><label asp-for="Ativo" class="form-check-label">Ativo</label></div></div></div>
<div class="mt-4"><button class="btn btn-primary">Salvar</button> <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
