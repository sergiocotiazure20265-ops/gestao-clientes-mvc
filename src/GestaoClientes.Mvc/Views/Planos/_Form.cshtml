@model Plano
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Id"/>
<div class="row g-3"><div class="col-md-8"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control"/><span asp-validation-for="Nome" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="ValorMensal" class="form-label"></label><input asp-for="ValorMensal" type="number" step="0.01" min="0.01" class="form-control"/><span asp-validation-for="ValorMensal" class="text-danger"></span></div>
<div class="col-12"><div class="form-check"><input asp-for="Ativo" class="form-check-input"/><label asp-for="Ativo" class="form-check-label">Ativo</label></div></div></div>
<div class="mt-4"><button class="btn btn-primary">Salvar</button> <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
