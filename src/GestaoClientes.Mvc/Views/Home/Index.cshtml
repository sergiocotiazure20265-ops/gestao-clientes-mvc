@{ ViewData["Title"] = "Dashboard"; }
<div class="mb-4"><h1>Dashboard</h1><p class="text-muted">Sistema monolítico de gestão. Pronto para o laboratório de refatoração com Codex.</p></div>
<div class="row g-3">
<div class="col-md-4"><div class="card p-4"><span class="text-muted">Clientes</span><h2>@ViewBag.Clientes</h2><a asp-controller="Clientes" asp-action="Index">Gerenciar clientes →</a></div></div>
<div class="col-md-4"><div class="card p-4"><span class="text-muted">Planos</span><h2>@ViewBag.Planos</h2><a asp-controller="Planos" asp-action="Index">Gerenciar planos →</a></div></div>
<div class="col-md-4"><div class="card p-4"><span class="text-muted">Contratos</span><h2>@ViewBag.Contratos</h2><a asp-controller="Contratos" asp-action="Index">Gerenciar contratos →</a></div></div>
</div>
<div class="alert alert-info mt-4"><b>Desafio SDD:</b> extrair Clientes e Planos para APIs independentes, manter Contratos no monólito e preservar todas as telas.</div>
